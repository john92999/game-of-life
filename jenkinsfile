pipeline {
    agent { label 'jenk' }

    triggers {
        pollSCM('* * * * *')
    }

    stages {

        stage('Source Code') {
            steps {
                git branch: 'develop',
                    url: 'https://github.com/john92999/game-of-life.git'
            }
        }

        stage('Build') {
            steps {
                sh 'mvn clean package -DskipTests'
            }
        }

        stage('Archive and Test Results') {
            steps {
                junit '**/surefire-reports/*.xml'
                archiveArtifacts artifacts: '**/*.jar', followSymlinks: false
            }
        }
    }
}
